<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The diary and settings are backed up / transferred; the API key is not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
